  <script>
    // Theme toggle
    const btn = document.getElementById('themeToggle');
    btn.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    });
    // Persist theme
    (function(){
      const saved = localStorage.getItem('theme');
      if(saved === 'dark') document.documentElement.classList.add('dark');
    })();

    // Dummy numbers & heat grid (replace with API later)
    const nifty = (Math.random()*20000+18000).toFixed(0);
    const sensex = (Math.random()*70000+60000).toFixed(0);
    document.getElementById('niftyVal').textContent = nifty;
    document.getElementById('sensexVal').textContent = sensex;

    const grid = document.getElementById('heatGrid');
    for(let i=0;i<24;i++){
      const v = Math.random()*2-1; // -1..1
      const cell = document.createElement('div');
      cell.title = v>0 ? `+${(v*2).toFixed(2)}%` : `${(v*2).toFixed(2)}%`;
      cell.className = 'rounded-md h-6 smooth';
      cell.style.backgroundColor = v>0 ? `rgba(34,197,94,${0.25+v/2})` : `rgba(239,68,68,${0.25+(-v)/2})`;
      grid.appendChild(cell);
    }

    // Subscribe mock
    function subscribe(){
      const email = document.getElementById('email').value;
      const msg = document.getElementById('subMsg');
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
        msg.textContent = 'Please enter a valid email.';
        return;
      }
      msg.textContent = `Thanks! Confirmation link sent to ${email}.`;
      document.getElementById('email').value='';
    }

    // Year
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>

